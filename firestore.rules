rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function invited() {
      return request.auth != null && request.auth.uid in [
        'ahZtOZv0wnboG5LFKU0Nx8BpJpq2',
        'ed9Ufp9pNRRY5qsFMneztfsxoff1'
      ];
    }
    function who() {
      return request.auth.uid == 'ahZtOZv0wnboG5LFKU0Nx8BpJpq2' ? 'Joe' : 'Noémie';
    }
    function validPlace(d) {
      return d.keys().hasOnly(['name','category','notes','addedBy','lat','lng','createdAt','status','reviewedBy','visitedAt','memoryNotes','photoUrl'])
        && d.keys().hasAll(['name','category','notes','addedBy','lat','lng','createdAt'])
        && d.name is string && d.name.size()>0 && d.name.size()<=100
        && d.notes is string && d.notes.size()<=1000
        && d.category in ['Agreed Trip','Wishlist - Her','Wishlist - Him','Wishlist - Joe','Wishlist - Noémie','Visited']
        && d.addedBy in ['Joe','Noémie']
        && d.lat is number && d.lat>=-90 && d.lat<=90
        && d.lng is number && d.lng>=-180 && d.lng<=180
        && d.createdAt is timestamp
        && (!d.keys().hasAny(['status']) || d.status in ['suggested','approved','visited','vetoed'])
        && (!d.keys().hasAny(['reviewedBy']) || d.reviewedBy in ['', 'Joe','Noémie'])
        && (!d.keys().hasAny(['visitedAt']) || d.visitedAt == null || d.visitedAt is timestamp)
        && (!d.keys().hasAny(['memoryNotes']) || (d.memoryNotes is string && d.memoryNotes.size()<=2000))
        && (!d.keys().hasAny(['photoUrl']) || (d.photoUrl is string && d.photoUrl.size()<=2000 && (d.photoUrl=='' || d.photoUrl.matches('https://.*'))));
    }
    function priorStatus() {
      return resource.data.get('status', resource.data.category=='Agreed Trip'?'approved':'suggested');
    }
    function futureStatus() {
      return request.resource.data.get('status', request.resource.data.category=='Agreed Trip'?'approved':'suggested');
    }
    function isDecision() {
      return priorStatus()=='suggested'
        && futureStatus() in ['approved','vetoed']
        && resource.data.addedBy != who()
        && request.resource.data.reviewedBy == who()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','category','reviewedBy'])
        && (futureStatus()!='approved' || request.resource.data.category=='Agreed Trip');
    }
    function isVisit() {
      return priorStatus() in ['approved','visited']
        && futureStatus()=='visited'
        && request.resource.data.category=='Visited'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','category','visitedAt','memoryNotes','photoUrl'])
        && request.resource.data.visitedAt is timestamp;
    }
    match /places/{placeId} {
      allow read: if invited();
      // Starter data created once, using an atomic transaction with meta/starter-seed.
      allow create: if invited() && validPlace(request.resource.data) && (
        (request.resource.data.status=='suggested'
          && request.resource.data.addedBy==who()
          && request.resource.data.category==('Wishlist - '+who())
          && request.resource.data.reviewedBy=='')
        || (placeId in ['starter-la-rochelle','starter-norway']
          && request.resource.data.status=='approved'
          && request.resource.data.category=='Agreed Trip')
      );
      allow update: if invited() && validPlace(request.resource.data)
        && request.resource.data.name==resource.data.name
        && request.resource.data.addedBy==resource.data.addedBy
        && request.resource.data.lat==resource.data.lat
        && request.resource.data.lng==resource.data.lng
        && request.resource.data.notes==resource.data.notes
        && request.resource.data.createdAt==resource.data.createdAt
        && (isDecision() || isVisit());
      allow delete: if invited();
    }
    match /meta/starter-seed {
      allow read: if invited();
      allow create: if invited()
        && request.resource.data.keys().hasOnly(['seededAt'])
        && request.resource.data.seededAt is timestamp;
      allow update, delete: if false;
    }
    // Independent, private checklist. No map data is involved.
    function validChecklist(d) {
      return d.keys().hasAll(['name','notes','addedBy','status','reviewedBy','joeStars','noemieStars','createdAt'])
        && d.keys().hasOnly(['name','notes','addedBy','status','reviewedBy','joeStars','noemieStars','createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.notes is string && d.notes.size() <= 500
        && d.addedBy in ['Joe','Noémie']
        && d.status in ['suggested','approved','vetoed','done']
        && d.reviewedBy in ['','Joe','Noémie']
        && d.createdAt is timestamp
        && d.joeStars is int && d.joeStars >= 0 && d.joeStars <= 10
        && d.noemieStars is int && d.noemieStars >= 0 && d.noemieStars <= 10;
    }
    match /placesTo/{itemId} {
      allow read: if invited();
      allow create: if invited() && validChecklist(request.resource.data)
        && request.resource.data.addedBy == who()
        && request.resource.data.status == 'suggested'
        && request.resource.data.reviewedBy == ''
        && request.resource.data.joeStars == 0 && request.resource.data.noemieStars == 0;
      allow update: if invited() && validChecklist(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','joeStars','noemieStars'])
        && (
          (resource.data.status == 'suggested'
           && resource.data.addedBy != who()
           && request.resource.data.status in ['approved','vetoed']
           && request.resource.data.reviewedBy == who()
           && request.resource.data.joeStars == 0 && request.resource.data.noemieStars == 0)
          || (resource.data.status == 'approved'
            && request.resource.data.status == 'approved'
            && request.resource.data.reviewedBy == resource.data.reviewedBy
            && ((who() == 'Joe' && request.resource.data.noemieStars == resource.data.noemieStars)
                || (who() == 'Noémie' && request.resource.data.joeStars == resource.data.joeStars)))
          || (resource.data.status == 'approved'
              && request.resource.data.status == 'done'
              && request.resource.data.reviewedBy == resource.data.reviewedBy
              && request.resource.data.joeStars == 0 && request.resource.data.noemieStars == 0)
        );
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
